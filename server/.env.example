# Local development defaults. Never commit server/.env.
# DATABASE_URI currently expects the MongoDB server URI without the /linea suffix.
# For MongoDB Atlas, the db connection code will be improved in Phase 2.
DATABASE_URI=mongodb://127.0.0.1:27017
PORT=3001
ORIGIN=http://localhost:5173

# Replace these placeholders with unique, long random secrets in your local .env.
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_1
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_NEW_RANDOM_SECRET_2
REFRESH_TOKEN_EXPIRY=7d
